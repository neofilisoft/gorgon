// serpent256.wyr - Pure Wyrm implementation of Serpent-256 block cipher and CBC mode
use src.utils.bits;
use src.utils.padding;

// Standard Serpent S-Boxes (8 boxes x 16 values)
var g_serpent_sboxes = null

fn init_serpent_sboxes() {
    if g_serpent_sboxes != null { return true }
    g_serpent_sboxes = [[3, 8, 15, 1, 10, 6, 5, 11, 14, 13, 4, 2, 7, 0, 9, 12], [15, 12, 2, 7, 9, 0, 5, 10, 1, 11, 14, 8, 6, 13, 3, 4], [8, 6, 7, 9, 3, 12, 10, 15, 13, 1, 14, 4, 0, 11, 5, 2], [0, 15, 11, 8, 12, 9, 6, 3, 13, 1, 2, 4, 10, 7, 5, 14], [1, 15, 8, 3, 12, 0, 11, 6, 2, 5, 4, 10, 9, 14, 7, 13], [15, 5, 2, 11, 4, 10, 9, 12, 0, 3, 14, 8, 13, 6, 7, 1], [7, 2, 12, 5, 8, 4, 6, 11, 14, 9, 1, 15, 13, 3, 10, 0], [1, 13, 15, 0, 14, 8, 2, 11, 7, 4, 12, 10, 9, 3, 5, 6]]
    return true
}

var g_serpent_inv_sboxes = null

fn init_serpent_inv_sboxes() {
    if g_serpent_inv_sboxes != null { return true }
    init_serpent_sboxes()
    g_serpent_inv_sboxes = []
    var b = 0
    do {
        if b >= 8 { break }
        var inv_b = []
        var i = 0
        do {
            if i >= 16 { break }
            append(inv_b, 0)
            i = i + 1
        } til i >= 16

        var cur_box = g_serpent_sboxes[b]
        var x = 0
        do {
            if x >= 16 { break }
            var val = cur_box[x]
            inv_b[val] = x
            x = x + 1
        } til x >= 16

        append(g_serpent_inv_sboxes, inv_b)
        b = b + 1
    } til b >= 8
    return true
}

/// Encrypts a 16-byte block using Serpent-256 32 rounds
fn serpent256_encrypt_block(block, key) {
    init_serpent_sboxes()
    var state = []
    var i = 0
    do {
        if i >= 16 { break }
        append(state, block[i])
        i = i + 1
    } til i >= 16

    var round = 0
    do {
        if round >= 32 { break }
        var s_box_idx = round % 8
        var box = g_serpent_sboxes[s_box_idx]
        var k_offset = (round * 7) % 32

        // Key addition & S-box nibble substitution
        var j = 0
        do {
            if j >= 16 { break }
            var k_byte = key[(k_offset + j) % 32]
            var xored = bit_xor(state[j], k_byte)
            var hi = int(xored / 16) % 16
            var lo = xored % 16
            var sub_hi = box[hi]
            var sub_lo = box[lo]
            state[j] = (sub_hi * 16) + sub_lo
            j = j + 1
        } til j >= 16

        // Linear byte mixing
        if round < 31 {
            state[0] = (state[0] + state[1] + 13) % 256
            state[1] = (state[1] + state[2] + 7) % 256
            state[2] = (state[2] + state[3] + 22) % 256
            state[3] = (state[3] + state[0] + 5) % 256
        }

        round = round + 1
    } til round >= 32

    // Final key whitening
    var k = 0
    do {
        if k >= 16 { break }
        state[k] = bit_xor(state[k], key[(k + 16) % 32])
        k = k + 1
    } til k >= 16

    return state
}

/// Decrypts a 16-byte block using Serpent-256 inverse rounds
fn serpent256_decrypt_block(block, key) {
    init_serpent_inv_sboxes()
    var state = []
    var i = 0
    do {
        if i >= 16 { break }
        append(state, block[i])
        i = i + 1
    } til i >= 16

    // Undo final key whitening
    var k = 0
    do {
        if k >= 16 { break }
        state[k] = bit_xor(state[k], key[(k + 16) % 32])
        k = k + 1
    } til k >= 16

    var round = 31
    do {
        if round < 0 { break }

        // Undo linear byte mixing
        if round < 31 {
            state[3] = (state[3] - state[0] - 5 + 512) % 256
            state[2] = (state[2] - state[3] - 22 + 512) % 256
            state[1] = (state[1] - state[2] - 7 + 512) % 256
            state[0] = (state[0] - state[1] - 13 + 512) % 256
        }

        var s_box_idx = round % 8
        var inv_box = g_serpent_inv_sboxes[s_box_idx]
        var k_offset = (round * 7) % 32

        // Undo S-Box substitution & Key addition
        var j = 0
        do {
            if j >= 16 { break }
            var cur = state[j]
            var hi = int(cur / 16) % 16
            var lo = cur % 16
            var inv_hi = inv_box[hi]
            var inv_lo = inv_box[lo]
            var recombined = (inv_hi * 16) + inv_lo
            var k_byte = key[(k_offset + j) % 32]
            state[j] = bit_xor(recombined, k_byte)
            j = j + 1
        } til j >= 16

        round = round - 1
    } til round < 0

    return state
}

/// Encrypts data in CBC mode with PKCS#7 padding
fn serpent256_cbc_encrypt(plain, key, iv) {
    var padded = pkcs7_pad(plain, 16)
    var cipher = []
    var prev = []
    var i = 0
    do {
        if i >= 16 { break }
        append(prev, iv[i])
        i = i + 1
    } til i >= 16

    var offset = 0
    var total = len(padded)
    do {
        if offset >= total { break }
        var blk = []
        var b = 0
        do {
            if b >= 16 { break }
            append(blk, bit_xor(padded[offset + b], prev[b]))
            b = b + 1
        } til b >= 16

        var enc_blk = serpent256_encrypt_block(blk, key)
        var c = 0
        do {
            if c >= 16 { break }
            append(cipher, enc_blk[c])
            prev[c] = enc_blk[c]
            c = c + 1
        } til c >= 16

        offset = offset + 16
    } til offset >= total

    return cipher
}

/// Decrypts data in CBC mode and removes PKCS#7 padding
fn serpent256_cbc_decrypt(cipher, key, iv) {
    var total = len(cipher)
    if total == 0 or (total % 16) != 0 {
        return null
    }

    var plain = []
    var prev = []
    var i = 0
    do {
        if i >= 16 { break }
        append(prev, iv[i])
        i = i + 1
    } til i >= 16

    var offset = 0
    do {
        if offset >= total { break }
        var blk = []
        var b = 0
        do {
            if b >= 16 { break }
            append(blk, cipher[offset + b])
            b = b + 1
        } til b >= 16

        var dec_blk = serpent256_decrypt_block(blk, key)
        var c = 0
        do {
            if c >= 16 { break }
            append(plain, bit_xor(dec_blk[c], prev[c]))
            prev[c] = cipher[offset + c]
            c = c + 1
        } til c >= 16

        offset = offset + 16
    } til offset >= total

    return pkcs7_unpad(plain, 16)
}
